# Copy to .env. Variables prefixed EXPO_PUBLIC_ are bundled into the app, so never put secrets here.
# Leave EXPO_PUBLIC_API_URL empty to auto-detect your laptop's LAN IP from the Expo dev server (port 8787).
# Set it explicitly when using a deployed backend or tunnel, e.g. https://abc123.ngrok.app
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
