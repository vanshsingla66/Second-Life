{
  "expo": {
    "name": "GREEN · Second Life",
    "slug": "green-second-life",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "greensecondlife",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.green.secondlife",
      "infoPlist": { "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true } }
    },
    "android": {
      "package": "com.green.secondlife",
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true
    },
    "web": { "output": "single", "bundler": "metro", "favicon": "./assets/images/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      ["expo-image-picker", { "photosPermission": "Allow GREEN to pick photos of the items you want to sell.", "cameraPermission": "Allow GREEN to take photos of the items you want to sell." }],
      ["expo-splash-screen", { "backgroundColor": "#16A34A", "image": "./assets/images/splash-icon.png", "imageWidth": 120 }]
    ],
    "experiments": { "typedRoutes": false }
  }
}
