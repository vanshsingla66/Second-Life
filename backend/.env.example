# Copy to .env and fill in. Never commit .env.
JWT_SECRET=change-me-to-a-long-random-string

# Database. Default is a local SQLite file. For Supabase paste the Postgres connection string from
# Dashboard -> Connect (use the "Session pooler" string), replacing [YOUR-PASSWORD] with your database password.
# Special characters in the password must be URL-encoded (@ -> %40, # -> %23, / -> %2F, : -> %3A).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./green.db

# Google OAuth client IDs (create in Google Cloud Console). Leave blank to disable Google sign-in.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Gemini API key (https://aistudio.google.com/apikey) for photo recognition and the in-app assistant.
# Server-side only. Leave blank to turn the AI features off. GEMINI_MODEL is optional.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
